    "nodes": [
      {
        "id": "shared",
        "title": "同一起点只准备一次",
        "body": "历史编码得到 z、c；完整起点已知未来路径经双向注意力得到 p[1:H]；lead 相对原起点，不随滑窗重置。",
        "x": 60,
        "y": 150,
        "w": 1680,
        "h": 115,
        "kind": "condition"
      },
      {
        "id": "direct_start",
        "title": "A 阶段 / direct：真实历史窗口",
        "body": "z 展平 + 真实负荷 + 观测/生成标记\n逐组 coverage/生成标记 + 日历四维",
        "x": 80,
        "y": 330,
        "w": 700,
        "h": 140,
        "kind": "state"
      },
      {
        "id": "direct_project",
        "title": "全部 token 特征联合投影",
        "body": "单 Linear → 加窗口内正弦位置\n日历已在 token 内，不再独立投影相加",
        "x": 80,
        "y": 520,
        "w": 700,
        "h": 140,
        "kind": "entity"
      },
      {
        "id": "direct_time",
        "title": "因果时间编码只运行一次",
        "body": "沿历史时间轴计算；取末位表示 h\n所有未来步共享这个历史表示",
        "x": 80,
        "y": 710,
        "w": 700,
        "h": 140,
        "kind": "state"
      },
      {
        "id": "direct_fusion",
        "title": "按未来步条件融合",
        "body": "拼接 h、固定 c、p[k]、lead(k)\n共享 Linear → GELU → Dropout → Linear",
        "x": 80,
        "y": 900,
        "w": 700,
        "h": 140,
        "kind": "condition"
      },
      {
        "id": "direct_load",
        "title": "仅负荷头；没有 latent 预测和回灌",
        "body": "各步共享 Linear(dt,1)\n收集 H 个预测，得到 [B,H,1]",
        "x": 80,
        "y": 1090,
        "w": 700,
        "h": 140,
        "kind": "output"
      },
      {
        "id": "direct_output",
        "title": "对外负荷预测",
        "body": "预测完成后反标准化\n物理单位遵循目标合同；不是 latent 的单位",
        "x": 80,
        "y": 1310,
        "w": 700,
        "h": 140,
        "kind": "output"
      },
      {
        "id": "ar_state",
        "title": "自由递推：内部滚动状态窗口",
        "body": "由真实历史初始化；窗口长度始终为 L\n预测写入内部状态，不改原始 target_history",
        "x": 980,
        "y": 330,
        "w": 700,
        "h": 140,
        "kind": "state"
      },
      {
        "id": "ar_project",
        "title": "全部 token 特征联合投影",
        "body": "单 Linear → 加当前窗口内正弦位置\n每步重算；不是 KV cache 或跨起点记忆",
        "x": 980,
        "y": 520,
        "w": 700,
        "h": 140,
        "kind": "entity"
      },
      {
        "id": "ar_time",
        "title": "每步重新计算因果时间编码",
        "body": "从当前窗口取末位表示 h[k]\n空间历史只编码一次，不随滑窗重新运行",
        "x": 980,
        "y": 710,
        "w": 700,
        "h": 140,
        "kind": "state"
      },
      {
        "id": "ar_fusion",
        "title": "按未来步条件融合",
        "body": "拼接当前 h[k]、固定 c、p[k]、lead(k)\np 来自完整起点已知路径，不刷新晚到条件",
        "x": 980,
        "y": 900,
        "w": 700,
        "h": 140,
        "kind": "condition"
      },
      {
        "id": "latent_head",
        "title": "动态组 latent 头",
        "body": "每组 Linear(dt,dz)\n预测 [B,Gd,dz]",
        "x": 980,
        "y": 1090,
        "w": 325,
        "h": 140,
        "kind": "output"
      },
      {
        "id": "load_head",
        "title": "总负荷头",
        "body": "共享 Linear(dt,1)\n预测 [B,1]",
        "x": 1355,
        "y": 1090,
        "w": 325,
        "h": 140,
        "kind": "output"
      },
      {
        "id": "append",
        "title": "追加预测状态，下一步取新的 L 长窗口",
        "body": "同时追加预测 z、y 与未来日历；丢弃最旧位置\nobserved=false，generated=true\ncoverage=0，group_generated=1；收集 H 步输出",
        "x": 980,
        "y": 1310,
        "w": 700,
        "h": 170,
        "kind": "state"
      }
