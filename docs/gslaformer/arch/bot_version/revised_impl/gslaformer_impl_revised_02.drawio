<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="GSLAformer · 直接预测与自由递推" id="gslaformer_impl_revised_02"><mxGraphModel dx="1800" dy="1440" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1600"><root><mxCell id="0" /><mxCell parent="0" id="1" /><mxCell parent="1" id="title" value="GSLAformer · 直接预测与自由递推" vertex="1" style="text;html=0;align=left;fontSize=34;fontColor=#203348;whiteSpace=wrap;"><mxGeometry as="geometry" x="60" y="22" width="1680" height="50" /></mxCell><mxCell parent="1" id="subtitle" value="02 / 两条路径分开：模型内部负荷为标准化坐标；对外结果另行反标准化" vertex="1" style="text;html=0;align=left;fontSize=21;fontColor=#203348;whiteSpace=wrap;"><mxGeometry as="geometry" x="60" y="76" width="1680" height="45" /></mxCell><mxCell parent="1" id="edge0" edge="1" source="direct_start" target="direct_project" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="430" y="470" /><mxPoint as="targetPoint" x="430" y="520" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge1" edge="1" source="direct_project" target="direct_time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="430" y="660" /><mxPoint as="targetPoint" x="430" y="710" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge2" edge="1" source="direct_time" target="direct_fusion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="430" y="850" /><mxPoint as="targetPoint" x="430" y="900" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge3" edge="1" source="ar_state" target="ar_project" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="470" /><mxPoint as="targetPoint" x="1330" y="520" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge4" edge="1" source="ar_project" target="ar_time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="660" /><mxPoint as="targetPoint" x="1330" y="710" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge5" edge="1" source="ar_time" target="ar_fusion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="850" /><mxPoint as="targetPoint" x="1330" y="900" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge6" edge="1" source="direct_fusion" target="direct_load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="430" y="1040" /><mxPoint as="targetPoint" x="430" y="1090" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge7" edge="1" source="direct_load" target="direct_output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="430" y="1230" /><mxPoint as="targetPoint" x="430" y="1310" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge8" edge="1" source="ar_fusion" target="latent_head" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.49846153846153846;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="1040" /><mxPoint as="targetPoint" x="1142" y="1090" /><Array as="points"><mxPoint x="1330" y="1065" /><mxPoint x="1142" y="1065" /></Array></mxGeometry></mxCell><mxCell parent="1" id="edge9" edge="1" source="ar_fusion" target="load_head" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5015384615384615;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="1040" /><mxPoint as="targetPoint" x="1518" y="1090" /><Array as="points"><mxPoint x="1330" y="1065" /><mxPoint x="1518" y="1065" /></Array></mxGeometry></mxCell><mxCell parent="1" id="edge10" edge="1" source="latent_head" target="append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.49846153846153846;exitY=1.0;entryX=0.23142857142857143;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1142" y="1230" /><mxPoint as="targetPoint" x="1142" y="1310" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge11" edge="1" source="load_head" target="append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5015384615384615;exitY=1.0;entryX=0.7685714285714286;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1518" y="1230" /><mxPoint as="targetPoint" x="1518" y="1310" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge12" edge="1" source="append" target="ar_state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1680" y="1395" /><mxPoint as="targetPoint" x="1680" y="400" /><Array as="points"><mxPoint x="1740" y="1395" /><mxPoint x="1740" y="400" /></Array></mxGeometry></mxCell><mxCell parent="1" id="shared" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;同一起点只准备一次&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;历史编码得到 z、c；完整起点已知未来路径经双向注意力得到 p[1:H]；lead 相对原起点，不随滑窗重置。&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="60" y="150" width="1680" height="115" /></mxCell><mxCell parent="1" id="direct_start" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;A 阶段 / direct：真实历史窗口&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;z 展平 + 真实负荷 + 观测/生成标记&lt;br&gt;逐组 coverage/生成标记 + 日历四维&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="80" y="330" width="700" height="140" /></mxCell><mxCell parent="1" id="direct_project" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;全部 token 特征联合投影&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;单 Linear → 加窗口内正弦位置&lt;br&gt;日历已在 token 内，不再独立投影相加&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="80" y="520" width="700" height="140" /></mxCell><mxCell parent="1" id="direct_time" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;因果时间编码只运行一次&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;沿历史时间轴计算；取末位表示 h&lt;br&gt;所有未来步共享这个历史表示&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="80" y="710" width="700" height="140" /></mxCell><mxCell parent="1" id="direct_fusion" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;按未来步条件融合&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;拼接 h、固定 c、p[k]、lead(k)&lt;br&gt;共享 Linear → GELU → Dropout → Linear&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="80" y="900" width="700" height="140" /></mxCell><mxCell parent="1" id="direct_load" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;仅负荷头；没有 latent 预测和回灌&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;各步共享 Linear(dt,1)&lt;br&gt;收集 H 个预测，得到 [B,H,1]&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="80" y="1090" width="700" height="140" /></mxCell><mxCell parent="1" id="direct_output" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;对外负荷预测&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;预测完成后反标准化&lt;br&gt;物理单位遵循目标合同；不是 latent 的单位&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="80" y="1310" width="700" height="140" /></mxCell><mxCell parent="1" id="ar_state" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;自由递推：内部滚动状态窗口&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;由真实历史初始化；窗口长度始终为 L&lt;br&gt;预测写入内部状态，不改原始 target_history&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="980" y="330" width="700" height="140" /></mxCell><mxCell parent="1" id="ar_project" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;全部 token 特征联合投影&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;单 Linear → 加当前窗口内正弦位置&lt;br&gt;每步重算；不是 KV cache 或跨起点记忆&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="980" y="520" width="700" height="140" /></mxCell><mxCell parent="1" id="ar_time" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;每步重新计算因果时间编码&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;从当前窗口取末位表示 h[k]&lt;br&gt;空间历史只编码一次，不随滑窗重新运行&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="980" y="710" width="700" height="140" /></mxCell><mxCell parent="1" id="ar_fusion" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;按未来步条件融合&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;拼接当前 h[k]、固定 c、p[k]、lead(k)&lt;br&gt;p 来自完整起点已知路径，不刷新晚到条件&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="980" y="900" width="700" height="140" /></mxCell><mxCell parent="1" id="latent_head" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;动态组 latent 头&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;每组 Linear(dt,dz)&lt;br&gt;预测 [B,Gd,dz]&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="980" y="1090" width="325" height="140" /></mxCell><mxCell parent="1" id="load_head" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;总负荷头&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;共享 Linear(dt,1)&lt;br&gt;预测 [B,1]&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="1355" y="1090" width="325" height="140" /></mxCell><mxCell parent="1" id="append" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;追加预测状态，下一步取新的 L 长窗口&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;同时追加预测 z、y 与未来日历；丢弃最旧位置&lt;br&gt;observed=false，generated=true&lt;br&gt;coverage=0，group_generated=1；收集 H 步输出&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="980" y="1310" width="700" height="170" /></mxCell><mxCell parent="1" id="legend_input" value="输入 / 证据" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="60" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_entity" value="实体 / 特征投影" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="300" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_spatial" value="空间 / 关系" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="540" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_state" value="状态 / 时间链" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="780" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_condition" value="条件 / teacher" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1020" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_output" value="预测 / 权重" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="1260" y="1532" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_loss" value="监督损失" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="1500" y="1532" width="210" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>