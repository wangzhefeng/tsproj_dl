 x="910" y="760" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge7" edge="1" source="relation" target="readout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="910" y="905" /><mxPoint as="targetPoint" x="910" y="965" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge8" edge="1" source="readout" target="z" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="910" y="1115" /><mxPoint as="targetPoint" x="910" y="1170" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge9" edge="1" source="origin" target="group_static" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1500" y="320" /><mxPoint as="targetPoint" x="1500" y="370" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge10" edge="1" source="group_static" target="c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1500" y="510" /><mxPoint as="targetPoint" x="1500" y="560" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="observations" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;历史实体观测与属性&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;逐组 [B,L,Ng,Fg]；实体身份只用于对齐&lt;br&gt;数值、观测、适用性、静态属性及有效性&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="60" y="180" width="480" height="140" /></mxCell><mxCell parent="1" id="adapter" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;逐组共享实体适配&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;动态值、掩码与属性拼接&lt;br&gt;Linear → GELU → Linear；输出宽度 ds&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="60" y="370" width="480" height="140" /></mxCell><mxCell parent="1" id="dynamic" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;动态组&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;同组共享 GRU&lt;br&gt;逐实体沿时间更新&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="60" y="560" width="225" height="140" /></mxCell><mxCell parent="1" id="static" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;纯静态组&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;无 GRU&lt;br&gt;适配结果直接传递&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="315" y="560" width="225" height="140" /></mxCell><mxCell parent="1" id="within" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;逐组、逐时刻的实体交互&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;实体 + summary token → 单层空间注意力&lt;br&gt;去掉 summary 输出；保留实体 [B,L,Ng,ds]&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="60" y="760" width="480" height="145" /></mxCell><mxCell parent="1" id="edges" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;历史关系与有效实体&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;每个历史时刻使用对应关系&lt;br&gt;有向类型、允许反向通信、padding / present&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="660" y="560" width="500" height="140" /></mxCell><mxCell parent="1" id="relation" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;跨组类型关系交互&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;在实体轴拼接全部 G 组；按帧独立计算&lt;br&gt;加性通信掩码与方向偏置；层数来自配置&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="660" y="760" width="500" height="145" /></mxCell><mxCell parent="1" id="readout" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;仅对动态组进行独立查询读出&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;Q：可学习查询；K/V：实体 + 常驻空组 token&lt;br&gt;池化结果拼接 log1p(N)、coverage → Linear&lt;br&gt; → LN&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="660" y="965" width="500" height="150" /></mxCell><mxCell parent="1" id="z" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;动态组历史状态 z&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;全窗口 [B,L,Gd,dz]；单时刻 [B,Gd,dz]&lt;br&gt;按组轴堆叠，进入时间链时才展平特征轴&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="660" y="1170" width="500" height="140" /></mxCell><mxCell parent="1" id="origin" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;预测起点的静态证据&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;有效实体的属性、类别与数量&lt;br&gt;起点关系的逐类型出入度；不读动态值&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="1260" y="180" width="480" height="140" /></mxCell><mxCell parent="1" id="group_static" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;逐组静态统计与投影&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;均值、总和、可用率、数量及度数&lt;br&gt;类别嵌入均值；每组 Linear → GELU&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1260" y="370" width="480" height="140" /></mxCell><mxCell parent="1" id="c" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;固定静态条件 c&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;拼接全部组统计表示 → 单 Linear&lt;br&gt;[B,dt]；同一起点的整段预测共用&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1260" y="560" width="480" height="140" /></mxCell><mxCell parent="1" id="scope" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;配置边界&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;G：全部组；Gd：动态组&lt;br&gt;所有组可参与关系；只有动态组产生 z&lt;br&gt;关系层通常为 2 层，但不是硬编码常量&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ffffff;strokeColor=#c4cfdb;"><mxGeometry as="geometry" x="1260" y="790" width="480" height="170" /></mxCell><mxCell parent="1" id="next" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;后续使用&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;z 与真实负荷历史用于时间预测&lt;br&gt;c 独立进入每一步条件融合&lt;br&gt;推理路径与训练路径分别见图 02、03&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ffffff;strokeColor=#c4cfdb;"><mxGeometry as="geometry" x="1260" y="1060" width="480" height="170" /></mxCell><mxCell parent="1" id="legend_input" value="输入 / 证据" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="60" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_entity" value="实体 / 特征投影" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="300" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_spatial" value="空间 / 关系" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="540" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_state" value="状态 / 时间链" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="780" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_condition" value="条件 / teacher" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1020" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_output" value="预测 / 权重" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="1260" y="1332" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_loss" value="监督损失" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="1500" y="1332" width="210" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>