l><mxCell parent="1" id="origin_input" value="预测起点的静态证据&#10;属性 / 类别 / 有效实体&#10;逐类型、逐方向的关系度数" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#8795a3;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="100.0" y="200.0" width="540.0" height="160.0" /></mxCell><mxCell parent="1" id="history_scope" value="EntityHistoryEncoder · 实体历史编码：GroupAdapter + 同组共享 GRUCell；缺席或填充实体的状态归零。" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=20.7;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="100.0" y="1756.0" width="1660.0" height="60.0" /></mxCell><mxCell parent="1" id="spatial_note" value="配置与表示边界&#10;本图为六动态组实例；其他配置可含纯静态组（无 GRU、不产生动态 latent）。&#10;实体身份只用于对齐；摘要 token 输出被丢弃，分组状态由独立查询读出。&#10;消融示例：no_spatial → GroupMeanReadout；no_entity_history → 无 GRU；total_only → 仅负荷。" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4cbd2;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="100.0" y="1850.0" width="1660.0" height="170.0" /></mxCell><mxCell parent="1" id="state_note" value="保留最近 L 个位置&#10;追加预测 z、y&#10;不覆盖真实历史" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="2580.0" y="1338.0" width="370.0" height="136.0" /></mxCell><mxCell parent="1" id="feedback_join" value="" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=0;arcSize=8;whiteSpace=wrap;fillColor=#b85450;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=19.8;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="3004.0" y="274.0" width="12.0" height="12.0" /></mxCell><mxCell parent="1" id="training_panel" value="(c) 两阶段训练 · 先学习表示，再训练自由递推" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#aeb9c5;align=left;verticalAlign=top;fontSize=25.2;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="40.0" y="2160.0" width="3000.0" height="460.0" /></mxCell><mxCell parent="1" id="stage_a" value="A · 直接多步负荷监督&#10;训练表示链及负荷预测路径&#10;latent 头冻结，不参与损失&#10;按验证集选出 best_A" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="90.0" y="2280.0" width="620.0" height="220.0" /></mxCell><mxCell parent="1" id="stage_freeze" value="加载 best_A · 冻结完整表示链&#10;实体历史 / 组内空间 / 关系 / 读出 / 静态链&#10;冻结模块保持 eval&#10;建立 latent 训练统计" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#d0ece7;strokeColor=#3f8f80;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="810.0" y="2280.0" width="720.0" height="220.0" /></mxCell><mxCell parent="1" id="stage_b" value="B · 双头自由递推&#10;预测负荷主损失 + latent 辅助损失&#10;时间链、未来路径、融合层与两头继续训练&#10;预测 z、y 回灌，不使用 teacher 真值回灌" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#7f96b8;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="1630.0" y="2280.0" width="720.0" height="220.0" /></mxCell><mxCell parent="1" id="teacher" value="仅训练使用的 teacher&#10;冻结表示链 + 未来实体监督&#10;复制历史末端 memory；no_grad&#10;latent 标签仅进入辅助损失" vertex="1" style="html=0;fontFamily=PingFang SC;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=21.6;spacing=4.0;strokeWidth=2.0;"><mxGeometry as="geometry" x="2450.0" y="2280.0" width="540.0" height="220.0" /></mxCell><mxCell parent="1" 