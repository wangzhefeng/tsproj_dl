<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="GSLAformer · 两阶段训练与监督隔离" id="gslaformer_impl_revised_03"><mxGraphModel dx="1800" dy="1440" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1540"><root><mxCell id="0" /><mxCell parent="0" id="1" /><mxCell parent="1" id="title" value="GSLAformer · 两阶段训练与监督隔离" vertex="1" style="text;html=0;align=left;fontSize=34;fontColor=#203348;whiteSpace=wrap;"><mxGeometry as="geometry" x="60" y="22" width="1680" height="50" /></mxCell><mxCell parent="1" id="subtitle" value="03 / full 的训练机制：teacher 仅产生监督标签，不进入生产预测状态；所有图示均非新增算法" vertex="1" style="text;html=0;align=left;fontSize=21;fontColor=#203348;whiteSpace=wrap;"><mxGeometry as="geometry" x="60" y="76" width="1680" height="45" /></mxCell><mxCell parent="1" id="edge0" edge="1" source="phase_a" target="freeze" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=1.0;exitY=0.4782608695652174;entryX=0.0;entryY=0.3793103448275862;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="530" y="215" /><mxPoint as="targetPoint" x="600" y="215" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge1" edge="1" source="freeze" target="phase_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=1.0;exitY=0.4827586206896552;entryX=0.0;entryY=0.4827586206896552;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1200" y="230" /><mxPoint as="targetPoint" x="1270" y="230" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge2" edge="1" source="a_input" target="a_direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="385" y="510" /><mxPoint as="targetPoint" x="385" y="570" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge3" edge="1" source="a_direct" target="a_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="385" y="710" /><mxPoint as="targetPoint" x="385" y="770" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge4" edge="1" source="a_loss" target="best" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="385" y="910" /><mxPoint as="targetPoint" x="385" y="970" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge5" edge="1" source="b_input" target="b_roll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1045" y="510" /><mxPoint as="targetPoint" x="1045" y="570" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge6" edge="1" source="b_roll" target="b_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1045" y="710" /><mxPoint as="targetPoint" x="1045" y="770" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge7" edge="1" source="b_y" target="loss_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1045" y="910" /><mxPoint as="targetPoint" x="1045" y="970" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge8" edge="1" source="teacher_input" target="teacher" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1545" y="510" /><mxPoint as="targetPoint" x="1545" y="570" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge9" edge="1" source="teacher" target="labels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1545" y="710" /><mxPoint as="targetPoint" x="1545" y="770" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge10" edge="1" source="labels" target="loss_z" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1545" y="910" /><mxPoint as="targetPoint" x="1545" y="970" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge11" edge="1" source="b_y" target="loss_z" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1240" y="840" /><mxPoint as="targetPoint" x="1350" y="1040" /><Array as="points"><mxPoint x="1295" y="840" /><mxPoint x="1295" y="1040" /></Array></mxGeometry></mxCell><mxCell parent="1" id="edge12" edge="1" source="loss_y" target="combined" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.21910112359550563;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1045" y="1110" /><mxPoint as="targetPoint" x="1045" y="1200" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="edge13" edge="1" source="loss_z" target="combined" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4a5e74;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.7808988764044944;entryY=0.0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1545" y="1110" /><mxPoint as="targetPoint" x="1545" y="1200" /><Array as="points" /></mxGeometry></mxCell><mxCell parent="1" id="phase_a" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;A：负荷监督学习表示&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;latent 头冻结，不参与此阶段损失&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="60" y="160" width="470" height="115" /></mxCell><mxCell parent="1" id="freeze" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;阶段切换：加载 best_A 并冻结表示链&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;冻结实体历史、组内空间、关系、读出、静态链&lt;br&gt;冻结模块保持 eval；建立 latent 训练统计&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="600" y="160" width="600" height="145" /></mxCell><mxCell parent="1" id="phase_b" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;B：自由递推与辅助监督&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;时间链、未来路径、融合层、两头继续训练&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="1270" y="160" width="470" height="145" /></mxCell><mxCell parent="1" id="a_input" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;历史与起点已知未来条件&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;真实未来负荷仅作为损失标签&lt;br&gt;不输入预测分支&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="60" y="370" width="650" height="140" /></mxCell><mxCell parent="1" id="a_direct" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;直接多步负荷预测&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;完整空间/关系编码 + 时间链 + 条件融合&lt;br&gt;调用负荷头，不调用 latent 头；不回灌&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="60" y="570" width="650" height="140" /></mxCell><mxCell parent="1" id="a_loss" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;主损失：预测负荷对真实标签&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;只在有效标签上计算&lt;br&gt;先按预测步分别平均，再等权汇总&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="60" y="770" width="650" height="140" /></mxCell><mxCell parent="1" id="best" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;验证集选择 best_A&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;B 从选中的 A 权重开始，而非最后一次更新&lt;br&gt;A 阶段不以 latent 辅助目标预训练 latent 头&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="60" y="970" width="650" height="140" /></mxCell><mxCell parent="1" id="curriculum" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;B 阶段课程与冻结边界&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;监督递推长度：1 → min(3,H) → H&lt;br&gt;未来条件仍编码完整 H；不截断回灌梯度&lt;br&gt;B 的主预测路径不读取未来真实负荷或实体值&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ffffff;strokeColor=#c4cfdb;"><mxGeometry as="geometry" x="60" y="1200" width="650" height="170" /></mxCell><mxCell parent="1" id="b_input" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;生产预测分支输入&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;真实历史 + 起点已知条件&lt;br&gt;不接收未来真值&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="850" y="370" width="390" height="140" /></mxCell><mxCell parent="1" id="b_roll" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;双头自由递推&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;历史编码一次并冻结&lt;br&gt;预测 z、y 回灌内部窗口&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="850" y="570" width="390" height="140" /></mxCell><mxCell parent="1" id="b_y" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;预测负荷与预测 latent&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;主损失读取预测负荷&lt;br&gt;辅助损失读取预测 latent&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="850" y="770" width="390" height="140" /></mxCell><mxCell parent="1" id="loss_y" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;主负荷损失&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;预测负荷对真实未来负荷&lt;br&gt;遵守有效标签掩码&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="850" y="970" width="390" height="140" /></mxCell><mxCell parent="1" id="teacher_input" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;仅训练可用的监督数据&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;未来实体观测及掩码&lt;br&gt;不是生产模型输入&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="1350" y="370" width="390" height="140" /></mxCell><mxCell parent="1" id="teacher" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;冻结 teacher：no_grad&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;复制历史末端实体 memory&lt;br&gt;按起点上下文顺序延续编码&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1350" y="570" width="390" height="140" /></mxCell><mxCell parent="1" id="labels" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;规范 latent 标签与质量 q&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;标签不写回生产窗口&lt;br&gt;质量及维度权重仅用于损失&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1350" y="770" width="390" height="140" /></mxCell><mxCell parent="1" id="loss_z" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;latent 辅助损失&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;预测 latent 对 teacher 标签&lt;br&gt;按质量及训练方差加权&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="1350" y="970" width="390" height="140" /></mxCell><mxCell parent="1" id="combined" value="&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:10px&quot;&gt;B 总损失与可训练参数更新&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:28px&quot;&gt;主负荷损失 + λ × latent 辅助损失&lt;br&gt;标准配置 λ=0.1；no_latent_loss 消融为 0&lt;br&gt;冻结表示链不更新；teacher 不替代任何一步预测输入&lt;/div&gt;" vertex="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#203348;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="850" y="1200" width="890" height="170" /></mxCell><mxCell parent="1" id="legend_input" value="输入 / 证据" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="60" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_entity" value="实体 / 特征投影" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ede9fe;strokeColor=#8b74b6;"><mxGeometry as="geometry" x="300" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_spatial" value="空间 / 关系" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fff0d9;strokeColor=#cd9450;"><mxGeometry as="geometry" x="540" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_state" value="状态 / 时间链" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e3f0ff;strokeColor=#5486b9;"><mxGeometry as="geometry" x="780" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_condition" value="条件 / teacher" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#ddf2ec;strokeColor=#589a8b;"><mxGeometry as="geometry" x="1020" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_output" value="预测 / 权重" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#e8f3de;strokeColor=#7d9d60;"><mxGeometry as="geometry" x="1260" y="1472" width="210" height="35" /></mxCell><mxCell parent="1" id="legend_loss" value="监督损失" vertex="1" style="rounded=0;html=0;fontSize=18;fillColor=#fbe6ea;strokeColor=#b97586;"><mxGeometry as="geometry" x="1500" y="1472" width="210" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>